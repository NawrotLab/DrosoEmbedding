# Copy this file to .env and fill in the two paths marked below.
# .env is excluded from version control (.gitignore).

# ─── Required for everything ──────────────────────────────────────────────
# Root of this (code) repository clone.
DROSO_ROOT=/path/to/DrosoEmbedding

# ─── Level 1: reproduce the figures ───────────────────────────────────────
# Root of the Data repository clone (https://gin.g-node.org/nawrotlab/DrosoEmbedding_WBCI).
# A plain `git clone` is enough here -- no git-annex, no `annex get`. Gives
# you evaluation/, results/ (merged per-figure results + src_imgs/) -- all
# 8 figures build from these, ~16MB total, no raw/preprocessed data needed.
DROSO_DATA_REPO=/path/to/DrosoEmbedding_WBCI
DROSO_PUBLISH_ROOT=${DROSO_DATA_REPO}

# ─── Level 2: retrain / re-evaluate from preprocessed data ────────────────
# Needs git-annex + `git annex get` for the preprocessed-frame archives
# (~27GB), then `bash scripts/setup_data.sh` to extract them -- see
# docs/FULL_REPRODUCTION.md.
DROSO_DATA_ROOT=${DROSO_DATA_REPO}/data
DROSO_PEAK_IDS=${DROSO_DATA_REPO}/data/IDs_logTs.pickle
DROSO_ALLT_BASE=${DROSO_DATA_REPO}/data/preprocessed_frames

# ─── Level 3: everything from raw recordings ──────────────────────────────
DROSO_RAW_RECORDINGS=${DROSO_DATA_REPO}/raw_recordings
# Node-local scratch storage used by src/preprocessing/clean_dataset*.py
# during preprocessing (e.g. /localscratch/your_username) -- genuinely
# machine/user-specific, unlike every path above.
DROSO_LOCAL_SCRATCH=/path/to/local_scratch
