# Copy this file to .env and set paths for your local environment.
# .env is excluded from version control (.gitignore).

# Root of the cloned repository (used to resolve relative imports when running scripts)
PYTHONPATH=/path/to/DrosoEmbedding

# Paths — override the placeholders in src/utils/config.yaml
DROSO_ROOT=/path/to/DrosoEmbedding
DROSO_DATA_ROOT=/path/to/data_root
DROSO_ALLT_BASE=/path/to/allTs_base
DROSO_PEAK_IDS=/path/to/IDs_logTs.pickle

# Checkpoints, source images, and figure output all live under DROSO_ROOT
# (results/_chkpt_finals, src/src_imgs, results/CombiPlots) — no separate
# env vars needed for these.
