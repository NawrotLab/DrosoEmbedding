# Copy this file to .env and set the two paths below -- or let
# `bash scripts/setup_data.sh /path/to/DrosoEmbedding_WBCI` write it for you.
# .env is excluded from version control (.gitignore).

# Root of this (code) repository clone
DROSO_ROOT=/path/to/DrosoEmbedding
# Root of the Data repository clone (https://gin.g-node.org/nawrotlab/DrosoEmbedding_WBCI)
DROSO_DATA_REPO=/path/to/DrosoEmbedding_WBCI

# Everything below is derived from the two paths above and normally needs
# no editing. Each overrides a placeholder in src/utils/config.yaml.
PYTHONPATH=${DROSO_ROOT}
# Trained checkpoints (models/<task>/) and cached evaluation results (evaluation/<task>/)
DROSO_PUBLISH_ROOT=${DROSO_DATA_REPO}
# Splits and recording metadata
DROSO_DATA_ROOT=${DROSO_DATA_REPO}/data
DROSO_PEAK_IDS=${DROSO_DATA_REPO}/data/splits/IDs_logTs.pickle
# Extracted frames (meanZ_allTs/, meanZ_allTs_KO_static_<neuropil>/) -- created by scripts/setup_data.sh
DROSO_ALLT_BASE=${DROSO_DATA_REPO}/frames
# Example raw recordings shown in Fig 1b
DROSO_RAW_RECORDINGS=${DROSO_DATA_REPO}/raw_recordings

# Only needed for re-running preprocessing from raw data (see
# docs/FULL_REPRODUCTION.md): node-local scratch storage used by
# src/preprocessing/clean_dataset*.py (e.g. /localscratch/your_username).
DROSO_LOCAL_SCRATCH=/path/to/local_scratch
