{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Run Python Script",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "env": { "PYTHONPATH": "${workspaceFolder}"},
            "justMyCode": true
        }
    ]
}